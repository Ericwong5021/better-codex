  "scripts": {
    "build": "npm run build:macos-desktop && npm run build:browser-ui && npm run build:desktop-bridge && npm run check:design-tokens && tsc",
    "dev": "tsx src/cli.ts serve",
    "dev:install": "npm run build && node scripts/development-instance.mjs install",
    "dev:mockup": "node scripts/dev-mockup.mjs",
    "dev:status": "node scripts/development-instance.mjs status",
    "dev:uninstall": "node scripts/development-instance.mjs uninstall",
    "package:binary": "node scripts/package.mjs",
    "package:update-manifest": "node scripts/create-update-manifest.mjs release",
    "release:beta": "node scripts/release-beta.mjs prepare",
    "release:beta:check": "node scripts/release-beta.mjs check",
    "start": "node dist/cli.js serve",
    "hub": "tsx src/hub-cli.ts",
    "hub:start": "node dist/hub-cli.js serve",
    "relay": "tsx src/relay-cli.ts",
    "relay:start": "node dist/relay-cli.js serve",
    "better-codex": "tsx src/cli.ts",
    "typecheck": "npm run check:browser-ui && npm run check:desktop-bridge && npm run check:design-tokens && tsc --noEmit",
    "check:plugin": "node scripts/validate-plugin.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "test": "tsx --test --test-force-exit --test-concurrency=2 test/*.test.ts",
    "test:web": "playwright test",
    "test:web:smoke": "playwright test test/e2e/web/local-smoke.spec.ts",
    "test:web:debug": "playwright test --headed --debug",
    "test:web:stack": "node scripts/test-web-stack.mjs",
    "test:web:selfhost": "playwright test test/e2e/selfhost",
    "test:deploy:selfhost": "node scripts/test-selfhost-deployment.mjs",
    "test:acceptance": "node scripts/run-acceptance.mjs",
    "dev:refresh": "npm run build && node scripts/refresh-local-install.mjs",
    "verify": "npm run typecheck && npm run check:plugin && npm test",
    "build:macos-desktop": "node scripts/build-macos-desktop.mjs",
    "test:macos-dmg": "node scripts/test-macos-dmg.mjs",
    "build:browser-ui": "node scripts/build-browser-ui.mjs",
    "check:browser-ui": "node scripts/build-browser-ui.mjs --check",
    "build:desktop-bridge": "node scripts/build-desktop-bridge.mjs",
    "check:desktop-bridge": "node scripts/build-desktop-bridge.mjs --check"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@playwright/test": "^1.62.1",
