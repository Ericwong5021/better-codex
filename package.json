{
  "name": "better-codex",
  "version": "0.4.1-beta.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "bin": {
    "better-codex": "dist/cli.js"
  },
  "files": [
    "dist/cdp.js",
    "dist/cli.js",
    "dist/design-system.js",
    "dist/appearance.js",
    "dist/agent-profiles.js",
    "dist/compatibility.js",
    "dist/config.js",
    "dist/db.js",
    "dist/dom.js",
    "dist/injection-state.js",
    "dist/locale.js",
    "dist/launch-integration.js",
    "dist/mcp-app.js",
    "dist/model-catalog.js",
    "dist/mockup.js",
    "dist/runtime-state.js",
    "dist/server.js",
    "dist/service.js",
    "dist/session-reply.js",
    "dist/session-transcript.js",
    "dist/markdown.js",
    "dist/updater.js",
    "dist/user-profile.js",
    "dist/worker.js"
  ],
  "scripts": {
    "build": "tsc && node scripts/refresh-local-install.mjs && node scripts/refresh-injector.mjs",
    "dev": "tsx src/cli.ts serve",
    "dev:install": "npm run build && node scripts/development-instance.mjs install",
    "dev:mockup": "node scripts/dev-mockup.mjs",
    "dev:status": "node scripts/development-instance.mjs status",
    "dev:uninstall": "node scripts/development-instance.mjs uninstall",
    "package:binary": "node scripts/package.mjs",
    "package:update-manifest": "node scripts/create-update-manifest.mjs release",
    "start": "node dist/cli.js serve",
    "better-codex": "tsx src/cli.ts",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "lucide-static": "^1.28.0"
  }
}
